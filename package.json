{
  "name": "xssploit",
  "version": "5.0.0",
  "private": true,
  "description": "XSSPLOIT — Personal AI-powered XSS scanner (single-user, local-first). Authorized engagements only.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "cli": "pnpm --filter @xssploit/cli start",
    "db:migrate": "pnpm --filter @xssploit/api run db:migrate",
    "payloads:collect": "bash scripts/payload-collector/collect.sh",
    "payloads:index": "python3 scripts/payload-collector/processors/index-builder.py"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "turbo": "^2.3.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
