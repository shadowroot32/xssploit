# ── XSSPLOIT Personal Edition — environment ──────────────────────────────
# Copy to .env and fill in. NEVER commit .env. Authorized targets only.

# Database (local-first SQLite file)
DATABASE_URL=./data/xssploit.db

# AI providers (tiered fallback: Claude → Antigravity → DeepSeek → Ollama → rule-based)
ANTHROPIC_API_KEY=
ANTIGRAVITY_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
AI_MAX_TOKENS_PER_SCAN=50000

# Single-user local auth token for the API (generate: openssl rand -hex 32)
LOCAL_AUTH_TOKEN=

# Blind XSS callback server
CALLBACK_HOST=0.0.0.0
CALLBACK_PORT=5001
CALLBACK_DOMAIN=localhost:5001
CALLBACK_TOKEN_SECRET=change-me-please

# Personal notification webhooks (YOUR channels only)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scanner defaults
DEFAULT_RATE_LIMIT=50
DEFAULT_MAX_PAGES=500
DEFAULT_CRAWL_DEPTH=5
DEFAULT_SCAN_TIMEOUT=7200

# API server
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:4000

# NOT PRESENT (v4 SaaS removed): STRIPE_*, NEXTAUTH_*, OAUTH_*
